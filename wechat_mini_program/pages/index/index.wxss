/* pages/index/index.wxss */
.container {
  padding-bottom: 40rpx;
}

.image-box {
  width: 100%;
  height: 420rpx;
  background-color: #F1F5F9;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #CBD5E1;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.placeholder-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.placeholder-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
}

.placeholder-sub {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

.action-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 16rpx;
}

.btn-sub {
  flex: 1;
  font-size: 26rpx;
  background: #F1F5F9;
  color: #475569;
  border-radius: 30rpx;
  padding: 14rpx 0;
  font-weight: 600;
}

.btn-danger {
  background: #FEE2E2;
  color: #EF4444;
}

.main-btn {
  margin-top: 24rpx;
  width: 100% !important;
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 结果卡片 */
.result-card {
  border-left: 8rpx solid #059669;
}

.justify-between {
  justify-content: space-between;
}

.primary-result {
  text-align: center;
  padding: 20rpx 0 10rpx;
}

.stage-zh-large {
  font-size: 52rpx;
  font-weight: 800;
  color: #047857;
  letter-spacing: 2rpx;
}

.stage-en-sub {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.confidence-badge {
  display: inline-block;
  background: #ECFDF5;
  color: #047857;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin: 16rpx 0;
}

.top3-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #475569;
  margin: 20rpx 0 12rpx;
}

.top3-item {
  margin-bottom: 16rpx;
}

.top3-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.top3-name {
  color: #334155;
  font-weight: 600;
}

.top3-conf {
  color: #059669;
  font-weight: 700;
}

/* 农艺建议卡片 */
.advice-box {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.advice-header {
  font-size: 28rpx;
  font-weight: 700;
  color: #166534;
  margin-bottom: 16rpx;

}

.advice-item {
  font-size: 24rpx;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.advice-label {
  font-weight: 700;
  color: #15803D;
}

.advice-val {
  color: #334155;
}

.btn-feedback {
  background: #EFF6FF;
  color: #2563EB;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  margin-top: 24rpx;
  padding: 16rpx 0;
  border: 1rpx solid #BFDBFE;
}

/* 弹窗通用基础 */
.modal-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-card {
  width: 84%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 20rpx;
}

.modal-input {
  background: #F8FAFC;
  border: 1rpx solid #CBD5E1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.modal-tips {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin: 16rpx 0 8rpx;
}

.picker-box {
  background: #F1F5F9;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #0F172A;
  font-weight: 600;
}

.modal-textarea {
  width: 100%;
  height: 140rpx;
  background: #F8FAFC;
  border: 1rpx solid #CBD5E1;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.modal-btn-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 36rpx;
  padding: 16rpx 0;
}

.btn-cancel {
  background: #F1F5F9;
  color: #64748B;
}

.btn-confirm {
  background: #047857;
  color: #FFFFFF;
}
