/** app.wxss - 全局高颜值农业 CSS 设计系统 **/
page {
  background-color: #F8FAFC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1E293B;
  box-sizing: border-box;
}

/* 渐变 Header 卡片 */
.header-banner {
  background: linear-gradient(135deg, #047857 0%, #064E3B 100%);
  padding: 30rpx 32rpx 36rpx;
  color: #FFFFFF;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(4, 120, 87, 0.2);
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
}

.header-subtitle {
  font-size: 24rpx;
  color: #A7F3D0;
  margin-top: 8rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.server-badge {
  font-size: 22rpx;
  color: #E2E8F0;
  background: rgba(255, 255, 255, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-config-icon {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #059669;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

/* 标准白色圆角卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
  border: 1rpx solid #F1F5F9;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

/* 按钮通用类 */
.btn-primary {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.3);
  transition: all 0.2s ease;
}

.btn-primary-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: #F1F5F9;
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* Badge 标签 */
.tag-crop {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.tag-corn {
  background-color: #FEF3C7;
  color: #D97706;
}

.tag-wheat {
  background-color: #E0E7FF;
  color: #4338CA;
}

.tag-cotton {
  background-color: #ECFDF5;
  color: #047857;
}

/* 置信度进度条 */
.progress-bar-bg {
  height: 16rpx;
  background-color: #E2E8F0;
  border-radius: 8rpx;
  overflow: hidden;
  width: 100%;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #10B981 0%, #059669 100%);
  border-radius: 8rpx;
  transition: width 0.4s ease;
}
