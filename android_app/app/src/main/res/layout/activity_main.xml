<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部 Header Banner (高颜值双行全宽布局，彻底解决按钮拥挤问题) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 标题与副标题行 -->
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾 农作物生育期智能诊断"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CLIP+LoRA 离线 NPU 引擎 · Corn / Wheat / Cotton"
                    android:textColor="#A7F3D0"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#33FFFFFF" />

                <!-- 2. 底部控制栏: 左侧 API 状态 + 右侧设置与语言按钮 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvCurrentServerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/layoutHeaderActions"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:background="#20FFFFFF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="🌐 API: http://10.0.2.2:8000"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/layoutHeaderActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnServerConfig"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#047857"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="⚙️ 服务器"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp" />

                        <Button
                            android:id="@+id/btnLangToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#475569"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="0dp"
                            android:text="🌐 EN/中"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </FrameLayout>



        <!-- 图片预览卡片 (带圆角与阴影) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F1F5F9">

                <ImageView
                    android:id="@+id/ivCropPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Crop Image Preview" />

                <TextView
                    android:id="@+id/tvImagePlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📷 点击下方按钮拍摄或选择农作物图片\nTap below to capture or pick a crop image"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 按钮控制区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="📷 拍照识别"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/emerald_dark"
                android:text="🖼️ 相册选择"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- 推理进度 -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:background="#ECFDF5"
            android:padding="12dp"
            android:clipToPadding="false">

            <ProgressBar
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:indeterminateTint="@color/emerald_primary" />

            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="⚡ 正在执行离线 ONNX AI 推理..."
                android:textColor="@color/emerald_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 诊断结果主卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 识别结果 Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCropName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="玉米 · 拔节期"
                        android:textColor="@color/emerald_dark"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/emerald_light"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="置信度: 94.2%"
                        android:textColor="@color/emerald_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="估算阶段周期: 15-20天 | 全生育期: 110-130天"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#E2E8F0" />

                <!-- 阶段形态特征描述 -->
                <TextView
                    android:id="@+id/tvHeaderDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 阶段形态特征描述"
                    android:textColor="@color/emerald_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="植株拔高齐腰，绿茎粗壮，有明显膨大节间。" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#E2E8F0" />

                <!-- 农艺养护指南 Header -->
                <TextView
                    android:id="@+id/tvHeaderAdvice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿 智能精细化农艺养护指南"
                    android:textColor="@color/emerald_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- 水分管理 -->
                <TextView
                    android:id="@+id/tvWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_water"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="💦 水分管理: 保持土壤湿度 60-70%" />

                <!-- 施肥调控 -->
                <TextView
                    android:id="@+id/tvFertilizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_fertilizer"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="#A16207"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="🌱 施肥调控: 重施拔节壮秆肥" />

                <!-- 关键农事 -->
                <TextView
                    android:id="@+id/tvOps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_ops"
                    android:padding="12dp"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="🌾 关键农事: 中耕培土 5-8 cm" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#E2E8F0" />

                <!-- 用户纠错与样本库上传交互按钮区 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFeedback"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#ECFDF5"
                        android:text="✏️ 结果纠错"
                        android:textColor="#059669"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnUploadDataset"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="#059669"
                        android:text="☁️ 上传样本库"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Top-3 候选匹配列表 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTopCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvHeaderCandidates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Top-3 候选匹配分析"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCandidate1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressCandidate1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/emerald_primary" />

                <TextView
                    android:id="@+id/tvCandidate2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressCandidate2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/accent_gold" />

                <TextView
                    android:id="@+id/tvCandidate3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressCandidate3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/text_muted" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
