<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部 Header Banner (带中英文语言切换按钮) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/emerald_dark"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnLangToggle"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌾 农作物生育期智能诊断"
                        android:textColor="@android:color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAppSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="CLIP+LoRA 离线 NPU 引擎 · Corn / Wheat / Cotton"
                        android:textColor="#A7F3D0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 中英文切换按钮 -->
                <Button
                    android:id="@+id/btnLangToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="#059669"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="🌐 English"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="19dp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- 图片预览卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivCropPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Crop Image Preview" />

                <TextView
                    android:id="@+id/tvImagePlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📷 点击下方按钮拍摄或选择农作物图片\nTap below to capture or pick a crop image"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- 按钮控制区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="📷 拍照识别"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/emerald_dark"
                android:text="🖼️ 相册选择"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- 推理进度 -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/emerald_primary" />

            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="⚡ 正在执行离线 ONNX AI 推理..."
                android:textColor="@color/emerald_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 诊断结果主卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCropName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="玉米 · 拔节期"
                        android:textColor="@color/emerald_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/emerald_light"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="置信度: 94.2%"
                        android:textColor="@color/emerald_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="估算阶段周期: 15-20天 | 全生育期: 110-130天"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:id="@+id/tvHeaderDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 阶段形态特征描述"
                    android:textColor="@color/emerald_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="植株拔高齐腰，绿茎粗壮，有明显膨大节间。" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:id="@+id/tvHeaderAdvice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿 智能农艺养护建议"
                    android:textColor="@color/emerald_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    tools:text="💦 水分管理: 保持土壤湿度 60-70%" />

                <TextView
                    android:id="@+id/tvFertilizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    tools:text="🌱 施肥调控: 重施拔节壮秆肥" />

                <TextView
                    android:id="@+id/tvPest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    tools:text="🛡️ 病虫害预警: 防治玉米螟、粘虫" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Top-3 候选匹配列表 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTopCandidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvHeaderCandidates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Top-3 候选匹配分析"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCandidate1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressCandidate1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/emerald_primary" />

                <TextView
                    android:id="@+id/tvCandidate2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressCandidate2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/accent_gold" />

                <TextView
                    android:id="@+id/tvCandidate3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressCandidate3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/text_muted" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
